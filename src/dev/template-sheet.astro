---
// The printable template sheet at /skill/template-sheet/ under `astro dev` only: astro.config.mjs
// injects this route for dev, so no build has it. A plain page, because it's only ever printed.
import { TemplateSheet } from '../components/cast/TemplateSheet';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cast template sheet</title>
    <style is:global>
      @page {
        size: letter;
        margin: 0.4in;
      }

      body {
        margin: 0;
        background: #fff;
        color: #000;
        font:
          9.5pt/1.3 Georgia,
          serif;
      }

      .sheet {
        width: 7.7in;
        margin: 0 auto;
      }

      h1 {
        margin: 0 0 0.05in;
        font-size: 13pt;
      }

      ol {
        margin: 0 0 0.1in;
        padding-left: 0.2in;
      }

      .inch {
        display: inline-block;
        width: 1in;
        height: 0.06in;
        background: #000;
        vertical-align: middle;
        print-color-adjust: exact;
      }

      .boxes {
        display: grid;
        grid-template-columns: repeat(2, max-content);
        justify-content: space-between;
        row-gap: 0.08in;
      }

      figure {
        margin: 0;
      }

      figcaption {
        font-weight: bold;
      }

      figure svg {
        display: block;
      }
    </style>
  </head>
  <body>
    <TemplateSheet />
  </body>
</html>
