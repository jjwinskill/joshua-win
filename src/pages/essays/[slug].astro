---
// An essay, on the template every piece shares.
import { getCollection } from 'astro:content';
import Piece from '../../layouts/Piece.astro';
import '../../styles/figures.css';

export async function getStaticPaths() {
  const pieces = await getCollection('lorem', ({ data }) => data.kind === 'essay');
  return pieces.map((piece) => ({ params: { slug: piece.id }, props: { piece } }));
}

const { piece } = Astro.props;
---

<Piece piece={piece} />
