---
// The essay template: complete and semantic, with no treatment.
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { CastList } from '../../components/cast/CastList';
import { castInOrderOfAppearance } from '../../components/cast/mentions';

export async function getStaticPaths() {
  const pieces = await getCollection('lorem');
  return pieces.map((piece) => ({ params: { slug: piece.id }, props: { piece } }));
}

const { piece } = Astro.props;
const { Content } = await render(piece);
const { title, dek, citedWork } = piece.data;
const cast = castInOrderOfAppearance(piece.body ?? '', piece.data.cast);
---

<Base title={title}>
  <article>
    <header class="essay-head">
      <p class="kicker">Essay · placeholder text</p>
      <h1>{title}</h1>
      <p class="dek">{dek}</p>
    </header>
    <div class="essay-body">
      <Content />
    </div>
  </article>
  <CastList cast={cast} citedWork={citedWork} />
</Base>
