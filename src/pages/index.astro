---
// The home page (S9, S19): it leads with Josh, then big cards, newest first. The paragraph is lorem
// until Josh writes the real lines (#11).
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { PieceCard } from '../components/PieceCard';
import { sitePath } from '../lib/paths';
import { pieceCast } from '../lib/piece-cast';
import { essayKicker, essayPath, newestFirst } from '../lib/pieces';

const pieces = await Promise.all(
  newestFirst(await getCollection('lorem')).map(async (piece) => ({
    piece,
    cast: await pieceCast(piece),
  })),
);
---

<Base title="Josh Winskill">
  <div class="home">
    <header class="home-lead">
      <h1>Josh Winskill</h1>
      <p>
        Dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore.
      </p>
    </header>
    <ol class="piece-cards">
      {pieces.map(({ piece, cast }) => (
        <li>
          <PieceCard
            href={sitePath(essayPath(piece.id))}
            slug={piece.id}
            kicker={essayKicker}
            title={piece.data.title}
            dek={piece.data.dek}
            cast={cast}
          />
        </li>
      ))}
    </ol>
  </div>
</Base>
