---
import { ClientRouter } from 'astro:transitions';
import '../styles/site.css';
import { sitePath } from '../lib/paths';

interface Props {
  title: string;
}

const { title } = Astro.props;

// Set only for production builds (G18), so previews and local builds aren't counted.
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <slot name="head" />
    <ClientRouter />
    <script is:inline>
      // An element off screen doesn't morph, or going back from far down an essay would fly its header in
      // from thousands of pixels away. Neither do other cards, which stay in the page behind the one that's
      // moving. Each page is checked just before it's captured. The router doesn't re-run an inline script
      // it has already seen, so these listeners are only added once.
      const syncMorphs = (isMoving) => {
        for (const el of document.querySelectorAll('[data-morph]')) {
          const { top, bottom } = el.getBoundingClientRect();
          const card = el.closest('.piece-card');
          const offScreen = bottom <= 0 || top >= innerHeight;
          el.toggleAttribute('data-no-morph', offScreen || (!!card && !isMoving(card)));
        }
      };
      // The boxes that can morph on this page, then which way the card is going, for site.css.
      const shownBoxes = () =>
        [...document.querySelectorAll('.piece-card:not([data-no-morph]), .piece-sheet')].map(
          (el) => el.style.viewTransitionName,
        );
      let destination;
      let leavingBoxes = [];
      let leavingSheet = false;
      document.addEventListener('astro:before-preparation', (event) => {
        destination = event.to.pathname;
      });
      document.addEventListener('astro:after-preparation', () => {
        syncMorphs((card) => new URL(card.href).pathname === destination);
        leavingBoxes = shownBoxes();
        leavingSheet = !!document.querySelector('.piece-sheet');
      });
      document.addEventListener('astro:after-swap', () => {
        syncMorphs((card) => leavingBoxes.includes(card.style.viewTransitionName));
        if (shownBoxes().some((box) => leavingBoxes.includes(box))) {
          document.documentElement.dataset.card = leavingSheet ? 'closing' : 'opening';
        }
      });
      // The router still runs a transition under reduced motion, so skip it. Skipping needs its own
      // listener because the transition only exists from this event on.
      document.addEventListener('astro:before-swap', (event) => {
        event.viewTransition.finished
          .catch(() => undefined)
          .finally(() => delete document.documentElement.dataset.card);
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
          event.viewTransition.ready.catch(() => undefined);
          event.viewTransition.skipTransition();
        }
      });
    </script>
  </head>
  <body>
    <nav class="site-nav" aria-label="Site">
      <a href={sitePath()}>joshua.win/skill</a>
      <a href={sitePath('contents/')}>Contents</a>
    </nav>
    <main>
      <slot />
    </main>
    {analyticsToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      />
    )}
  </body>
</html>
