---
import '../styles/site.css';
import { sitePath } from '../lib/paths';

interface Props {
  title: string;
}

const { title } = Astro.props;

// Set only for production builds (G18), so previews and local builds aren't counted.
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      // Going back from far down an essay, its header would fly in from thousands of pixels away. So an
      // element off screen doesn't morph, and the page crossfades instead. It's a classic script in the
      // head because pagereveal fires before the first render.
      const syncMorphs = (event) => {
        if (!event.viewTransition) return;
        for (const el of document.querySelectorAll('[data-morph]')) {
          const { top, bottom } = el.getBoundingClientRect();
          el.toggleAttribute('data-no-morph', bottom <= 0 || top >= innerHeight);
        }
      };
      addEventListener('pageswap', syncMorphs);
      addEventListener('pagereveal', syncMorphs);
    </script>
  </head>
  <body>
    <nav class="site-nav" aria-label="Site">
      <a href={sitePath()}>joshua.win/skill</a>
      <a href={sitePath('contents/')}>Contents</a>
    </nav>
    <main>
      <slot />
    </main>
    {analyticsToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      />
    )}
  </body>
</html>
