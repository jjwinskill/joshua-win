{
  // The Worker runs in workerd, not a browser, so it gets its own types from `wrangler types`
  // (worker-configuration.d.ts, generated by `pnpm typecheck` and git-ignored) instead of DOM types.
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "types": ["../worker-configuration.d.ts"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["./**/*.ts"]
}
